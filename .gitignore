node_modules/
.next/

# Build output (static export) — regenerated by `npm run build`, never committed
out/

# Generated full-text search index — regenerated before every dev/build
# (scripts/gen-search-index.mjs), fetched lazily at runtime, never committed.
public/search-index.json

*.tsbuildinfo
next-env.d.ts
.DS_Store

# NOTE: lib/last-updated.json IS committed on purpose.
# It is regenerated before every build (scripts/gen-last-updated.mjs),
# but keeping it tracked ensures a fresh clone can `tsc`/build without
# first running the generator (the file is imported by components/LastUpdated.tsx).
